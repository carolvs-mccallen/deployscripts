[slacktechnologies_slack]
name=Slack
baseurl=https://packagecloud.io/slacktechnologies/slack/fedora/21/$basearch
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=https://slack.com/gpg/slack_pubkey_20260921.gpg
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300

[slacktechnologies_slack-source]
name=Slack (source)
baseurl=https://packagecloud.io/slacktechnologies/slack/fedora/21/SRPMS
repo_gpgcheck=1
gpgcheck=1
enabled=1
gpgkey=https://slack.com/gpg/slack_pubkey_20260921.gpg
sslverify=1
sslcacert=/etc/pki/tls/certs/ca-bundle.crt
metadata_expire=300
